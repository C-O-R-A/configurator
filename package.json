{
  "name": "cora-configurator",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/frontend\" \"npm run dev --workspace=apps/backend\"",
    "build": "npm run build --workspace=apps/frontend",
    "start": "electron electron.js",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "org.cora.configurator",
    "productName": "CORA Configurator",
    "files": [
      "electron.js",
      "apps/frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "apps/backend/dist/cora-backend",
        "to": "backend/cora-backend"
      }
    ],
    "linux": { "target": "AppImage", "icon": "assets/icon.png" },
    "mac":   { "target": "dmg" },
    "win":   { "target": "nsis" }
  }
}