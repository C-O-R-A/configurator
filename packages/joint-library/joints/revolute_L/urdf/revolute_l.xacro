<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="revolute_l_properties.xacro" />

  <xacro:macro name="revolute_l" params="prefix parent *origin
      mass='1.6'
      ixx='0.005898' ixy='0' ixz='0' iyy='0.003584' iyz='0.000096' izz='0.005765'
      effort='10' velocity='1' lower='-3.141593' upper='3.141593'">

    <joint name="${prefix}mount" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}revolute_l" />
    </joint>

    <link name="${prefix}revolute_l">
      <visual>
        <origin xyz="0 0 0" rpy="1.570796 0 0" />
        <geometry><mesh filename="meshes/revolute_l_visual.glb" /></geometry>
        <material name="joint_material" />
      </visual>
      <collision>
        <geometry><mesh filename="meshes/revolute_l_collision.stl" /></geometry>
      </collision>
      <inertial>
        <mass value="${mass}" />
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}" />
      </inertial>
    </link>

    <link name="${prefix}joint_in" />
    <link name="${prefix}joint_out" />

    <joint name="${prefix}joint_in_joint" type="revolute">
      <origin xyz="0 -0.088002 0" rpy="1.570796 -1.570796 0" />
      <parent link="${prefix}revolute_l" />
      <child link="${prefix}joint_in" />
      <axis xyz="0 0 1" />
      <limit effort="${effort}" velocity="${velocity}" lower="${lower}" upper="${upper}" />
    </joint>

    <joint name="${prefix}joint_out_joint" type="fixed">
      <origin xyz="0 0 -0.070002" rpy="0 0 -1.570796" />
      <parent link="${prefix}revolute_l" />
      <child link="${prefix}joint_out" />
    </joint>

  </xacro:macro>
</robot>