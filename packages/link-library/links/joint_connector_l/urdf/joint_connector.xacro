<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="revolute_l_connector" params="prefix parent *origin
      mass='1.0'
      ixx='0.000944' ixy='0' ixz='0' iyy='0.001135' iyz='0' izz='0.001933'">

    <joint name="${prefix}connector_mount" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}joint_connector" />
    </joint>

    <link name="${prefix}joint_connector">
      <visual>
        <origin xyz="0 0 0" rpy="1.570796 0 0" />
        <geometry><mesh filename="meshes/joint_connector_visual.glb" /></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="meshes/joint_connector_collision.stl" /></geometry>
      </collision>
      <inertial>
        <mass value="${mass}" />
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}" />
      </inertial>
    </link>

    <link name="${prefix}clamp_in" />
    <link name="${prefix}clamp_out" />

    <joint name="${prefix}clamp_in_joint" type="fixed">
      <origin xyz="0.235657 0 -0.014095" rpy="0 0 0" />
      <parent link="${prefix}joint_connector" />
      <child link="${prefix}clamp_in" />
    </joint>

    <joint name="${prefix}clamp_out_joint" type="fixed">
      <origin xyz="0.235657 0 0.015912" rpy="0 0 0" />
      <parent link="${prefix}joint_connector" />
      <child link="${prefix}clamp_out" />
    </joint>

  </xacro:macro>
</robot>